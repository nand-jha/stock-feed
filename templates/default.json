{
  "name": "default",
  "description": "Keep items whose title names the company and that contain material stock news. Everything else is rejected and logged with the reason.",
  "require_ticker_in_title": true,
  "exclude_keywords": [
    "sponsored",
    "promo code",
    "coupon",
    "giveaway",
    "how to watch",
    "horoscope",
    "best deals",
    "sign up",
    "quiz"
  ],
  "exclude_sources": [],
  "include_keywords": {
    "earnings": 3,
    "revenue": 2,
    "guidance": 3,
    "eps": 2,
    "quarter": 1,
    "downgrade": 3,
    "upgrade": 3,
    "price target": 3,
    "analyst": 2,
    "acquisition": 3,
    "acquire": 2,
    "merger": 3,
    "buyback": 2,
    "dividend": 2,
    "lawsuit": 2,
    "sec": 2,
    "fda": 2,
    "ceo": 2,
    "layoff": 2,
    "recall": 2,
    "stake": 1,
    "partnership": 1,
    "forecast": 2,
    "rating": 2,
    "reiterate": 2,
    "reiterates": 2,
    "target": 2,
    "outlook": 2,
    "talks": 2,
    "deal": 2,
    "contract": 2,
    "ipo": 2,
    "spin-off": 2,
    "surge": 2,
    "surges": 2,
    "soar": 2,
    "soars": 2,
    "jump": 2,
    "jumps": 2,
    "plunge": 2,
    "plunges": 2,
    "tumble": 2,
    "tumbles": 2,
    "slump": 2,
    "sink": 2,
    "sinks": 2,
    "rally": 2,
    "rallies": 2,
    "sell-off": 2
  },
  "min_score": 3,
  "fields": [
    "ticker",
    "title",
    "source",
    "published",
    "link",
    "score"
  ],
  "publish": {
    "skip_empty": true,
    "header": "**{name} ({ticker})** · {count} item(s) · {date}",
    "item": "- {time} · {title} · {source} · [link]({link})",
    "empty": "_No relevant news in this window._",
    "more": "_+{n} more not shown_",
    "max_items_per_message": 10
  },
  "reject_analyst_firm_mentions": true
}
